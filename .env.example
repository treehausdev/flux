# Your first name. Triage uses it so your own name isn't mistaken for a contact.
FLUX_OWNER=

# Where your vault lives, relative to this folder. Default: brain
# FLUX_VAULT=brain

# One key per Granola account. Generate one in the Granola desktop app:
#   Settings -> Connectors -> API keys   (scope: Personal notes)
# The word after GRANOLA_KEY_ becomes the account label on synced files, so
# you can have more than one: GRANOLA_KEY_PERSONAL, GRANOLA_KEY_WORK, ...
GRANOLA_KEY_PERSONAL=

# Optional: Pocket (heypocket.com) for in-person recordings. One key per account.
# Run `npm run sync:pocket -- --probe` once after adding a key to check the
# field mapping against the live API before anything is written.
# POCKET_KEY_PERSONAL=
# Extra Pocket tags that mark a recording as a room you observed.
# FLUX_OBSERVED_TAGS=workshop,cohort
